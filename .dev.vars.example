APP_URL=http://localhost:5180
# 手元ではメールを送らず、管理画面の「送信ログ」に残すだけにする（本番は wrangler.jsonc の "resend"）
EMAIL_PROVIDER=log
# メールアドレスなどの暗号化の鍵。`openssl rand -base64 32` を実行し、表示された文字列（44文字ほど）を = の後ろに貼る（コマンド自体は貼らない）
TOKEN_ENC_KEY=
# 最初の管理者を作るときの合言葉。`openssl rand -base64 24` の出力を貼る
ADMIN_SETUP_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Aiteru <noreply@example.com>
